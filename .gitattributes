# ============================================
# Git Attributes - Line Ending Configuration
# Ensures consistent line endings across platforms
# ============================================

# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pro text eol=lf
*.sh text eol=lf

# Batch files (Windows) should use CRLF
*.bat text eol=crlf

# Binary files (declare as binary so Git won't change line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.apk binary
*.aab binary
*.jar binary
*.aar binary
*.so binary
*.dex binary
*.class binary
*.keystore binary
*.jks binary

# Gradle wrapper files
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle-wrapper.jar binary
